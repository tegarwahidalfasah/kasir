# ============================================================================
#  Kasir — contoh variabel lingkungan
# ============================================================================
#  Cara pakai:
#    1) salin berkas ini:            cp .env.example .env
#    2) isi nilainya (minimal KASIR_JWT_SECRET untuk produksi)
#
#  PENTING: aplikasi ini tidak memakai dotenv.
#  Node TIDAK membaca berkas .env secara otomatis. Pilih salah satu cara memuatnya:
#
#    a. lewat flag bawaan Node 22:   node --env-file=.env server/src/index.js
#    b. ekspor ke shell:             set -a && . ./.env && set +a && npm start
#    c. systemd (produksi):          EnvironmentFile=/etc/kasir/kasir.env  (lihat ops/kasir.service)
#
#  `npm run db:setup` membaca .env otomatis lewat flag Node bawaan.
#
#  Berkas .env sudah masuk .gitignore — jangan pernah commit nilai asli.
# ============================================================================


# ---------------------------------------------------------------- runtime API
# Port API. Saat `client/dist` ada, SPA juga dilayani dari port yang sama.
PORT=4000

# `production` → pesan error 5xx tidak dikirim ke klien (hanya ke log server).
# Setel ini saat toko benar-benar dipakai; biarkan kosong saat pengembangan.
NODE_ENV=production

# HANYA SQLite lokal/VPS. Jangan salin path ini ke Vercel/Turso.
# Direktori berisi kasir.db dan folder backups/.
# Default di kode: server/src/data  ·  rekomendasi produksi: /var/lib/kasir
KASIR_DATA_DIR=/var/lib/kasir

# Jalur lengkap berkas DB; menimpa KASIR_DATA_DIR sepenuhnya. Biasanya cukup dikosongkan.
# KASIR_DB_PATH=/var/lib/kasir/kasir.db

# Tujuan `npm run backup`. Default: <KASIR_DATA_DIR>/backups
# KASIR_BACKUP_DIR=/var/lib/kasir/backups


# ------------------------------------------------------------------- keamanan
# WAJIB diisi di produksi DAN untuk Vercel/Turso: openssl rand -hex 32
# Hanya pengembangan SQLite lokal yang boleh memakai secret otomatis.
# Mengganti nilai ini membuat semua token yang beredar langsung tidak berlaku (semua kasir login ulang).
KASIR_JWT_SECRET=

# Masa berlaku token sesi, dalam DETIK. Default 43200 (12 jam).
KASIR_TOKEN_TTL=43200

# Lokasi berkas rahasia alternatif (dipakai bila KASIR_JWT_SECRET kosong).
# KASIR_SECRET_FILE=/var/lib/kasir/.jwt-secret

# Seberapa jauh header X-Forwarded-For dipercaya (Express `trust proxy`).
# Default: `loopback` (hanya proxy di mesin yang sama, cocok untuk ops/ Caddy/nginx satu mesin);
# di Vercel otomatis `true`. Nilai yang terlalu longgar membuat pembatas login per-IP bisa
# dilewati dengan XFF palsu — set `1` (satu proxy) atau CIDR bila proxy ada di mesin lain.
# Nilai yang diterima: false | 0 | 1 | 2 | loopback | uniquelocal | 10.0.0.0/8
KASIR_TRUST_PROXY=loopback

# Batas percobaan login GAGAL per 60 detik (in-memory: hilang saat restart, per proses).
# Ember per-IP; KASIR_LOGIN_LIMIT_USER adalah ember per-username yang tidak bisa diakali
# dengan mengganti IP — penting karena PIN kasir hanya 4 digit.
KASIR_LOGIN_LIMIT_IP=5
KASIR_LOGIN_LIMIT_USER=8


# ------------------------------------------------------- pengembangan & uji
# Port dev server Vite (npm run dev).
# CLIENT_PORT=5173

# Target proxy /api milik Vite — juga dipakai `npm run maintenance -- health`.
# Default: http://127.0.0.1:${PORT}
# API_URL=http://127.0.0.1:4000

# Basis URL yang dipakai smoke UI (client/tests) — default http://127.0.0.1:4100
# KASIR_API=http://127.0.0.1:4100

# `npm run test`: biarkan direktori DB sementara tetap ada setelah tes untuk diperiksa.
# TEST_KEEP=1

# Tampilkan durasi untuk setiap tes yang lebih lambat dari 1,5 detik.
# KASIR_TEST_TIMING=1

# `npm run seed`: jangan tutup koneksi DB di akhir skrip (untuk inspeksi manual).
# KASIR_KEEP_OPEN=1


# ------------------------------------------------------------ Vercel + Turso
# Panduan: docs/12-vercel-turso.md. Jangan gunakan prefix VITE_ untuk kredensial.
# Di Vercel keduanya WAJIB. Tidak ada fallback SQLite /tmp jika kosong/salah.
# Scope Preview dan Production sebaiknya memakai DB dan secret terpisah.
# TURSO_DATABASE_URL=libsql://nama-database-organisasi.turso.io
# TURSO_AUTH_TOKEN=

# Setup via dashboard tanpa komputer lokal: KASIR_SETUP_DEMO=1 pada Preview SAJA.
# Aktifkan Deployment Protection dan gunakan DB demo terpisah sebelum redeploy.
# Hapus flag setelah setup berhasil. Production/Development/lokal ditolak.
# KASIR_SETUP_DEMO=1
#
# Alternatif setup satu kali dari komputer operator (bukan auto-seed runtime):
# npm run db:setup -- --demo    → demo privat, akun publik budi/dewi
# npm run db:setup -- --owner   → toko kosong + akun pribadi dari variabel berikut
# KASIR_OWNER_USERNAME=
# KASIR_OWNER_PASSWORD=
# KASIR_STORE_NAME=Toko Saya
# Password owner minimal 12 karakter. Hapus KASIR_OWNER_* setelah setup;
# tidak perlu menyimpannya di Vercel. Tetap gunakan NODE_ENV=production di Vercel.

# KASIR_AUTOSEED hanya untuk jalur lokal non-production; diabaikan pada Turso/Vercel.
# KASIR_AUTOSEED=1
# Izin seed historis manual SQLite lokal saat NODE_ENV=production:
# KASIR_ALLOW_SEED=1

# VERCEL=1  # diisi otomatis oleh platform, tidak perlu diatur sendiri
